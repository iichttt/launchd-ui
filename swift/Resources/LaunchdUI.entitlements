<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app shells out to /bin/launchctl and reads plists across LaunchAgents and
	     LaunchDaemons, so it cannot run inside the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
